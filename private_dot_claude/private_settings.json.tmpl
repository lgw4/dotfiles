{
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "65",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1",
    "DISABLE_TELEMETRY": "1"
  },
  "permissions": {
  {{- if eq .chezmoi.hostname (onepasswordRead "op://Work/Secrets/mbp_hostname") }}
    "allow": [
      "mcp__cai-mcp__getRallyItem",
      "mcp__cai-mcp__getGithubRepository",
      "mcp__cai-mcp__getGithubOrganization",
      "mcp__cai-mcp__listGithubRepositories"
    ],
  {{- end }}
    "defaultMode": "auto"
  },
  "autoMemoryEnabled": false,
  "model": "opusplan",
  "effortLevel": "auto",
  "outputStyle": "Concise",
  "hooks" : {
    "SessionStart" : [
      {
        "hooks" : [
          {
            "command" : "\"$HOME\/.claude\/hooks\/restore-default-model.sh\"",
            "statusMessage" : "Checking default model setting",
            "timeout" : 10,
            "type" : "command"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "disableClaudeAiConnectors": true,
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline-command.sh\""
  },
  "extraKnownMarketplaces": {
    "speckit-support-skills": {
      "source": {
        "source": "github",
        "repo": "lgw4/speckit-support-skills"
      }
    },
    "fluent-python-skills": {
      "source": {
        "source": "git",
        "url": "https://lgw4@github.com/lgw4/fluent-python-skills.git"
      }
    }
  },
{{- if eq .chezmoi.hostname (onepasswordRead "op://Work/Secrets/mbp_hostname") }}
  "mcpServers": {
    "cai-mcp": {
      "type": "stdio",
      "command": "cai-mcp",
      "args": ["--config", "~/.caimcp/config.yaml"]
    }
  },
{{- end }}
  "tui": "fullscreen",
  "theme": "light",
  "spinnerTipsEnabled": false,
  "enabledPlugins": {
    "fluent-python@fluent-python-skills": true,
    "sks@speckit-support-skills": true
  }
}
