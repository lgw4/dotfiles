{
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "65",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1",
    "DISABLE_TELEMETRY": "1"
  },
  "permissions": {
  {{- if eq .chezmoi.hostname (onepasswordRead "op://Work/Secrets/mbp_hostname") }}
    "allow": [
      "mcp__cai-mcp__getRallyItem",
      "mcp__cai-mcp__getGithubRepository",
      "mcp__cai-mcp__getGithubOrganization",
      "mcp__cai-mcp__listGithubRepositories"
    ],
  {{- end }}
    "defaultMode": "auto"
  },
  "model": "opusplan",
  "hooks" : {
    "Notification" : [
      {
        "hooks" : [
          {
            "command" : "'\/Users\/{{ .chezmoi.username }}\/Library\/Application Support\/Bartender\/NotchBar\/AgentStatus\/hooks\/claude-event-hook.sh' Waiting # notchbar-agents-claude-hook",
            "type" : "command"
          }
        ]
      }
    ],
    "PostToolUse" : [
      {
        "hooks" : [
          {
            "command" : "'\/Users\/{{ .chezmoi.username }}\/Library\/Application Support\/Bartender\/NotchBar\/AgentStatus\/hooks\/claude-event-hook.sh' Auto # notchbar-agents-claude-hook",
            "type" : "command"
          }
        ]
      }
    ],
    "PostToolUseFailure" : [
      {
        "hooks" : [
          {
            "command" : "'\/Users\/{{ .chezmoi.username }}\/Library\/Application Support\/Bartender\/NotchBar\/AgentStatus\/hooks\/claude-event-hook.sh' ToolFail # notchbar-agents-claude-hook",
            "type" : "command"
          }
        ]
      }
    ],
    "PreToolUse" : [
      {
        "hooks" : [
          {
            "command" : "'\/Users\/{{ .chezmoi.username }}\/Library\/Application Support\/Bartender\/NotchBar\/AgentStatus\/hooks\/claude-event-hook.sh' Working # notchbar-agents-claude-hook",
            "type" : "command"
          }
        ]
      }
    ],
    "SessionEnd" : [
      {
        "hooks" : [
          {
            "command" : "'\/Users\/{{ .chezmoi.username }}\/Library\/Application Support\/Bartender\/NotchBar\/AgentStatus\/hooks\/claude-event-hook.sh' Ended # notchbar-agents-claude-hook",
            "type" : "command"
          }
        ]
      }
    ],
    "SessionStart" : [
      {
        "hooks" : [
          {
            "command" : "\"$HOME\/.claude\/hooks\/restore-default-model.sh\"",
            "statusMessage" : "Checking default model setting",
            "timeout" : 10,
            "type" : "command"
          }
        ]
      },
      {
        "hooks" : [
          {
            "command" : "'\/Users\/{{ .chezmoi.username }}\/Library\/Application Support\/Bartender\/NotchBar\/AgentStatus\/hooks\/claude-event-hook.sh' Idle # notchbar-agents-claude-hook",
            "type" : "command"
          }
        ]
      }
    ],
    "Stop" : [
      {
        "hooks" : [
          {
            "command" : "'\/Users\/{{ .chezmoi.username }}\/Library\/Application Support\/Bartender\/NotchBar\/AgentStatus\/hooks\/claude-event-hook.sh' Idle # notchbar-agents-claude-hook",
            "type" : "command"
          }
        ]
      }
    ],
    "UserPromptSubmit" : [
      {
        "hooks" : [
          {
            "command" : "'\/Users\/{{ .chezmoi.username }}\/Library\/Application Support\/Bartender\/NotchBar\/AgentStatus\/hooks\/claude-event-hook.sh' Working # notchbar-agents-claude-hook",
            "type" : "command"
          }
        ]
      }
    ]
  },
  "disableClaudeAiConnectors": true,
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline-command.sh\""
  },
  "extraKnownMarketplaces": {
    "speckit-support-skills": {
      "source": {
        "source": "github",
        "repo": "lgw4/speckit-support-skills"
      }
    },
{{- if eq .chezmoi.hostname (onepasswordRead "op://Work/Secrets/mbp_hostname") }}
    "fluent-python-skills": {
      "source": {
        "source": "git",
        "url": "https://{{ onepasswordRead "op://Work/Secrets/ghes_fqdn" }}/Chip-Warden/fluent-python-skills.git"
      }
    }
  },
  "mcpServers": {
    "cai-mcp": {
      "type": "stdio",
      "command": "cai-mcp",
      "args": ["--config", "~/.caimcp/config.yaml"]
    }
  },
{{- else if and (ne .chezmoi.hostname (onepasswordRead "op://Work/Secrets/mbp_hostname")) (eq .chezmoi.os "darwin") }}
    "fluent-python-skills": {
      "source": {
        "source": "git",
        "url": "https://github.com/lgw4/fluent-python-skills.git"
      }
    }
  },
{{- end }}
  "tui": "fullscreen",
  "theme": "light",
  "spinnerTipsEnabled": false,
  "enabledPlugins": {
    "fluent-python@fluent-python-skills": true,
    "sks@speckit-support-skills": true
  }
}
