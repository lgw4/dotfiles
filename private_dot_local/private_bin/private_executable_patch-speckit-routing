#!/usr/bin/env sh
# patch-speckit-routing.sh
#
# Pins models for Spec Kit skills by forking each one into a subagent, because
# skill and command frontmatter `model:` is silently ignored at runtime
# (anthropics/claude-code#45191, closed not-planned) while subagent frontmatter
# `model:` is honored.
#
#   implement            -> fork to speckit-implementer  (Sonnet)
#   git-*, taskstoissues -> fork to git-ops              (Haiku)
#   clarify, checklist   -> untouched; they hold question dialogs with the
#                           user, which forked skills cannot do (subagents
#                           lose AskUserQuestion). They inherit the session
#                           model: to run them on Opus, open /model, pick
#                           Opus, and press `s` (session-only) first.
#   everything else      -> fork to speckit-opus         (Opus)
#
# Also strips any leftover `model:` line from every Spec Kit skill, since those
# do nothing and only mislead the next person reading the file.
#
# Idempotent: safe to re-run after every `specify init` or Spec Kit upgrade.
# POSIX sh; awk verified against mawk, gawk --posix, and busybox awk.

set -eu

SKILLS_DIR="${1:-.claude/skills}"

# Every agent a routing below can point at. Existence is checked at the end;
# a fork to a missing agent fails silently at invocation time.
AGENTS="speckit-implementer speckit-opus git-ops"

# Top-level frontmatter keys this script owns. Anything matching is removed
# before the desired set is written back, which is what makes it idempotent.
MANAGED_KEYS='^(model|context|agent|background):'

# Lines to insert, "|"-separated. Empty means strip-only.
routing_for() {
  case "$1" in
    implement)           echo "context: fork|agent: speckit-implementer|background: false" ;;
    git-*|taskstoissues) echo "context: fork|agent: git-ops|background: false" ;;
    clarify|checklist)   echo "" ;;
    *)                   echo "context: fork|agent: speckit-opus|background: false" ;;
  esac
}

if [ ! -d "$SKILLS_DIR" ]; then
  echo "error: skills dir not found: $SKILLS_DIR" >&2
  echo "pass the path as arg 1, e.g. $0 path/to/.claude/skills" >&2
  exit 1
fi

# Rewrites the leading frontmatter block only. CR-tolerant: detects the file's
# line terminator and reuses it, so CRLF files stay CRLF. Writes back through
# the original path so symlinks, inode, and mode survive.
patch_frontmatter() {
  _f=$1
  _tmp=$1.tmp.$$
  awk -v insert="$2" -v strip="$MANAGED_KEYS" '
    BEGIN { n = split(insert, want, "|") }
    function emit(s) { print s eol }
    NR==1 {
      eol = (/\r$/ ? "\r" : "")
      if ($0 !~ /^---\r?$/) {              # no frontmatter: create one
        emit("---")
        for (i = 1; i <= n; i++) emit(want[i])
        emit("---")
        print
        next
      }
      print; in_fm = 1; next               # opening fence
    }
    in_fm && $0 ~ strip { next }           # drop keys we manage
    in_fm && /^---\r?$/ {                  # closing fence: write ours back
      for (i = 1; i <= n; i++) emit(want[i])
      in_fm = 0; print; next
    }
    { print }
  ' "$_f" > "$_tmp"
  cat "$_tmp" > "$_f"
  rm -f "$_tmp"
}

count=0
routed=0
for file in "$SKILLS_DIR"/speckit-*/SKILL.md; do
  [ -f "$file" ] || continue              # POSIX has no nullglob; skip non-match
  dir=$(basename "$(dirname "$file")")
  cmd=${dir#speckit-}
  routing=$(routing_for "$cmd")
  patch_frontmatter "$file" "$routing"
  if [ -n "$routing" ]; then
    agent=${routing#*agent: }
    agent=${agent%%|*}
    printf '  %-24s -> fork to %s\n' "$cmd" "$agent"
    routed=$((routed + 1))
  else
    printf '  %-24s -> inherits session model (interactive)\n' "$cmd"
  fi
  count=$((count + 1))
done

if [ "$count" -eq 0 ]; then
  echo "error: no speckit-*/SKILL.md found under $SKILLS_DIR" >&2
  echo "check the layout: ls $SKILLS_DIR" >&2
  exit 1
fi

if [ "$routed" -eq 0 ]; then
  echo "error: no skills were routed under $SKILLS_DIR" >&2
  echo "check the skill directory names" >&2
  exit 1
fi

# The forks point at agents this script does not create. A missing agent
# means silent failure at invocation time, so say so now. Agent identity
# comes from the `name:` field, not the filename, and project and user
# scopes both resolve, so search on name across both.
agent_defined_in() {
  [ -d "$1" ] || return 1
  [ -n "$(find "$1" -type f -name '*.md' -exec grep -lE \
      "^name:[[:space:]]*[\"']?$2[\"']?[[:space:]]*\$" {} + 2>/dev/null \
      | head -1)" ]
}

missing=0
for agent in $AGENTS; do
  agent_scope=""
  for dir in "$(dirname "$SKILLS_DIR")/agents" "$HOME/.claude/agents"; do
    if agent_defined_in "$dir" "$agent"; then
      agent_scope=$dir
      break
    fi
  done
  if [ -n "$agent_scope" ]; then
    echo "  agent '$agent' found in $agent_scope"
  else
    echo "warning: no agent named '$agent' in project or user scope" >&2
    echo "         create it or the forks pointing at it have nothing to run" >&2
    missing=$((missing + 1))
  fi
done

echo "patched $count skill(s) in $SKILLS_DIR ($routed routed, $missing agent(s) missing)"
